@model IEnumerable<Library.domain.Models.Loan>

@{
    ViewData["Title"] = "Loans";
}

<h1>Loans</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Loan</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Book</th>
            <th>Member</th>
            <th>Loan Date</th>
            <th>Due Date</th>
            <th>Returned Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>
                @item.Book?.Title
            </td>
            <td>
                @item.Member?.FullName
            </td>
            <td>
                @item.LoanDate.ToString("dd/MM/yyyy")
            </td>
            <td>
                @item.DueDate.ToString("dd/MM/yyyy")
            </td>
            <td>
                @(item.ReturnedDate?.ToString("dd/MM/yyyy") ?? "-")
            </td>
            <td>
                @if (item.ReturnedDate == null)
                {
                    @if (item.DueDate < DateTime.Now)
                    {
                        <span class="text-danger fw-bold">Overdue</span>
                    }
                    else
                    {
                        <span class="text-warning fw-bold">On Loan</span>
                    }
                }
                else
                {
                    <span class="text-success fw-bold">Returned</span>
                }
            </td>
            <td>
                @if (item.ReturnedDate == null)
                {
                    <a asp-action="Return" asp-route-id="@item.Id">Return</a> <text>|</text>
                }
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>