@model Library.domain.Models.Loan

@{
    ViewData["Title"] = "Loan Details";
}

<h1>Loan Details</h1>

<div>
    <h4>Loan</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Book</dt>
        <dd class="col-sm-10">@Model.Book?.Title</dd>

        <dt class="col-sm-2">Member</dt>
        <dd class="col-sm-10">@Model.Member?.FullName</dd>

        <dt class="col-sm-2">Loan Date</dt>
        <dd class="col-sm-10">@Model.LoanDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Due Date</dt>
        <dd class="col-sm-10">@Model.DueDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2">Returned Date</dt>
        <dd class="col-sm-10">@(Model.ReturnedDate?.ToString("dd/MM/yyyy") ?? "-")</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">
            @if (Model.ReturnedDate == null)
            {
                @if (Model.DueDate < DateTime.Now)
                {
                    <span class="text-danger fw-bold">Overdue</span>
                }
                else
                {
                    <span class="text-warning fw-bold">On Loan</span>
                }
            }
            else
            {
                <span class="text-success fw-bold">Returned</span>
            }
        </dd>
    </dl>
</div>

<div>
    @if (Model.ReturnedDate == null)
    {
        <a asp-action="Return" asp-route-id="@Model.Id" class="btn btn-warning">Return</a>
    }
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
